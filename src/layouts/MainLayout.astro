---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { generateFaqSchema } from "../lib/faq-schema";
import { homeSchema } from "../lib/home-schema";

const {
  title,
  description,
  canonical,
  html = "",
  articleSchema,
  breadcrumbs,
  amp,
  slug,
  isHome = false
} = Astro.props;

const faqSchema = generateFaqSchema(html);



---

<!doctype html>
<html lang="id">
<head>
  <SeoHead
  title={title}
  description={description}
  canonical={canonical}
  articleSchema={articleSchema}
  breadcrumbs={breadcrumbs}
  faqSchema={faqSchema}
  amp={amp}
  slug={slug}
  isHome={isHome}
/>

{isHome && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(homeSchema)}
  />
)}


<script is:inline>
  if (localStorage.getItem("theme") === "light") {
    document.documentElement.classList.add("light-mode");
  }
</script>
</head>

<body>

  <Header />

  <main>
    <slot />
  </main>

  <Footer />


<script is:inline>
(function () {
  "use strict";

  /* Mobile nav toggle */
  var toggle = document.getElementById("navToggle");
  var mobileNav = document.getElementById("navMobile");

  if (toggle && mobileNav) {
    toggle.addEventListener("click", function () {
      mobileNav.classList.toggle("open");
    });

    mobileNav.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", function () {
        mobileNav.classList.remove("open");
      });
    });
  }

  /* Smooth scroll for anchor links */
  document.querySelectorAll('a[href^="#"]').forEach(function (anchor) {
    anchor.addEventListener("click", function (e) {
      var target = document.querySelector(this.getAttribute("href"));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });

  /* Copy SHA-256 hash */
  var copyBtn = document.getElementById("copyHash");
  var hashEl = document.getElementById("shaHash");

  if (copyBtn && hashEl) {
    copyBtn.addEventListener("click", function () {
      var text = hashEl.textContent.trim();
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          copyBtn.textContent = "Disalin!";
          setTimeout(function () {
            copyBtn.textContent = "Salin Hash";
          }, 2000);
        });
      }
    });
  }

  /* Header shadow on scroll */
  var header = document.querySelector(".site-header");
  if (header) {
    window.addEventListener("scroll", function () {
      if (window.scrollY > 10) {
        header.style.boxShadow = "0 2px 12px rgba(0,0,0,0.08)";
      } else {
        header.style.boxShadow = "0 1px 8px rgba(0,0,0,0.04)";
      }
    });
  }
})();
</script>
</SeoHead>
