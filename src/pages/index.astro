      </div>
      <div class="screenshots-grid">
        <div class="screenshot-item">
          <img src="https://Ferdy.rutesokin.monster/promo_1.webp" alt="Tampilan antarmuka pengguna Ai Mr Ferdy yang intuitif." class="screenshot-img" width="384" height="688" loading="lazy" decoding="async">
          <p class="screenshot-caption">Tampilan antarmuka pengguna Ai Mr Ferdy yang intuitif.</p>
        </div>
        <div class="screenshot-item">
          <img src="https://Ferdy.rutesokin.monster/promo_2.webp" alt="Proses unduhan aplikasi di Ai Mr Ferdy yang cepat dan mudah." class="screenshot-img" width="384" height="688" loading="lazy" decoding="async">
          <p class="screenshot-caption">Proses unduhan aplikasi di Ai Mr Ferdy yang cepat dan mudah.</p>
        </div>
        <div class="screenshot-item">
          <img src="https://Ferdy.rutesokin.monster/promo_3.webp" alt="Beragam kategori aplikasi di Ai Mr Ferdy untuk semua pengguna." class="screenshot-img" width="384" height="688" loading="lazy" decoding="async">
          <p class="screenshot-caption">Beragam kategori aplikasi di Ai Mr Ferdy untuk semua pengguna.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ulasan Pengguna — index10, index11, index12 + mingzi + diqu -->
