---
import '../styles/faq.css';
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';

const pageTitle =
  'FAQ AI Mr Ferdy - Pertanyaan Umum Seputar AI, Teknologi & Solusi Digital';

const pageDescription =
  'Temukan jawaban atas berbagai pertanyaan seputar AI Mr Ferdy, platform AI Indonesia yang menyediakan AI Tools, teknologi digital, otomatisasi, aplikasi, SEO, tutorial, dan solusi produktivitas digital.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={SITE.url('faq')}
>

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span>›</span>
        FAQ
      </nav>

      <h1>
        FAQ AI Mr Ferdy: Pertanyaan Umum Seputar AI, Teknologi & Solusi Digital
      </h1>

      <p class="page-hero-lead">
        Temukan jawaban atas berbagai pertanyaan mengenai AI Mr Ferdy,
        mulai dari AI Tools, teknologi digital, otomatisasi, aplikasi,
        SEO, keamanan digital, tutorial, hingga berbagai solusi
        produktivitas yang tersedia dalam ekosistem AI Mr Ferdy.
      </p>

    </div>
  </section>

  <!-- FAQ Body -->
  <section class="section">
    <div class="container">

      <div class="faq-search" role="search">
        <label class="faq-search-label" for="faqSearchInput">
          Cari pertanyaan
        </label>

        <input
          type="search"
          id="faqSearchInput"
          class="faq-search-input"
          placeholder="Ketik kata kunci, misalnya AI, tools, teknologi, aplikasi, SEO…"
          autocomplete="off"
          enterkeyhint="search"
        >

        <p
          class="faq-search-status"
          id="faqSearchStatus"
          aria-live="polite"
          hidden
        ></p>
      </div>

      <div class="faq-cats">
        <a href="#ai">AI & AI Tools</a>
        <a href="#teknologi">Teknologi</a>
        <a href="#aplikasi">Aplikasi</a>
        <a href="#keamanan">Keamanan Digital</a>
        <a href="#tutorial">Tutorial</a>
        <a href="#dukungan">Informasi</a>
      </div>

      <!-- AI & AI Tools -->
      <div class="faq-group" id="ai">

        <h2 class="faq-group-title">
          <span>🤖</span> AI & AI Tools
        </h2>

        <details class="faq-details">
          <summary>Apa itu AI Mr Ferdy?</summary>

          <div class="faq-answer">
            <p>
              AI Mr Ferdy adalah platform AI Indonesia yang menghadirkan
              berbagai AI Tools, teknologi digital, otomatisasi,
              aplikasi, dan solusi produktivitas untuk membantu pengguna
              memanfaatkan kecerdasan buatan dalam berbagai kebutuhan.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary>AI Tools apa yang tersedia di AI Mr Ferdy?</summary>

          <div class="faq-answer">
            <p>
              AI Mr Ferdy menyediakan berbagai tools berbasis
              kecerdasan buatan untuk mendukung pembuatan konten,
              produktivitas, otomatisasi, SEO, pengembangan website,
              dan kebutuhan digital lainnya.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Siapa yang dapat menggunakan AI Mr Ferdy?</summary>

          <div class="faq-answer">
            <p>
              AI Mr Ferdy dapat digunakan oleh pengguna teknologi,
              kreator konten, pengembang, pelaku usaha, maupun pengguna
              umum yang ingin memanfaatkan AI dan teknologi digital
              untuk meningkatkan produktivitas.
            </p>
          </div>
        </details>

      </div>

      <!-- Teknologi -->
      <div class="faq-group" id="teknologi">

        <h2 class="faq-group-title">
          <span>💻</span> Teknologi
        </h2>

        <details class="faq-details">
          <summary>Topik teknologi apa yang tersedia?</summary>

          <div class="faq-answer">
            <p>
              AI Mr Ferdy membahas berbagai perkembangan teknologi,
              kecerdasan buatan, pengembangan website, aplikasi,
              layanan digital, otomatisasi, serta berbagai teknologi
              modern yang relevan dengan kebutuhan pengguna.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah informasi teknologi cocok untuk pemula?</summary>

          <div class="faq-answer">
            <p>
              Ya. Pembahasan teknologi di AI Mr Ferdy disajikan dengan
              bahasa yang sederhana agar dapat dipahami oleh pemula
              maupun pengguna yang sudah berpengalaman.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Seberapa sering informasi teknologi diperbarui?</summary>

          <div class="faq-answer">
            <p>
              Informasi dan artikel diperbarui secara berkala mengikuti
              perkembangan teknologi dan kebutuhan pengguna.
            </p>
          </div>
        </details>

      </div>

      <!-- Aplikasi -->
      <div class="faq-group" id="aplikasi">

        <h2 class="faq-group-title">
          <span>📱</span> Aplikasi
        </h2>

        <details class="faq-details">
          <summary>Apakah AI Mr Ferdy membahas berbagai aplikasi?</summary>

          <div class="faq-answer">
            <p>
              Ya. AI Mr Ferdy menyediakan informasi mengenai berbagai
              aplikasi, fitur, penggunaan, pembaruan, serta teknologi
              yang berkaitan dengan aplikasi digital.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah tersedia tutorial penggunaan aplikasi?</summary>

          <div class="faq-answer">
            <p>
              Tersedia. Berbagai tutorial disusun dengan langkah-langkah
              yang jelas agar mudah diikuti oleh pengguna.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Bagaimana cara menemukan aplikasi tertentu?</summary>

          <div class="faq-answer">
            <p>
              Anda dapat menggunakan fitur pencarian atau mengunjungi
              bagian aplikasi untuk menemukan informasi mengenai aplikasi
              yang tersedia di AI Mr Ferdy.
            </p>
          </div>
        </details>

      </div>

      <!-- Keamanan -->
      <div class="faq-group" id="keamanan">

        <h2 class="faq-group-title">
          <span>🔒</span> Keamanan Digital
        </h2>

        <details class="faq-details">
          <summary>Apakah AI Mr Ferdy membahas keamanan digital?</summary>

          <div class="faq-answer">
            <p>
              Ya. AI Mr Ferdy membahas keamanan digital, keamanan akun,
              perlindungan data, privasi, serta berbagai tips untuk
              menjaga aktivitas digital tetap aman.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary>
            Bagaimana cara meningkatkan keamanan saat beraktivitas online?
          </summary>

          <div class="faq-answer">
            <p>
              Gunakan kata sandi yang kuat, aktifkan autentikasi dua
              faktor, lakukan pembaruan perangkat secara rutin, dan
              hindari membuka tautan atau memasang aplikasi dari sumber
              yang tidak terpercaya.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah informasi keamanan diperbarui?</summary>

          <div class="faq-answer">
            <p>
              Informasi keamanan diperbarui secara berkala agar tetap
              relevan dengan perkembangan teknologi dan ancaman digital.
            </p>
          </div>
        </details>

      </div>

      <!-- Tutorial -->
      <div class="faq-group" id="tutorial">

        <h2 class="faq-group-title">
          <span>📚</span> Tutorial & Tips Digital
        </h2>

        <details class="faq-details">
          <summary>Jenis tutorial apa yang tersedia?</summary>

          <div class="faq-answer">
            <p>
              AI Mr Ferdy menyediakan tutorial seputar AI, teknologi,
              aplikasi, SEO, website, otomatisasi, serta berbagai tips
              digital yang dapat diterapkan dalam aktivitas sehari-hari.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah tutorial mudah dipahami?</summary>

          <div class="faq-answer">
            <p>
              Ya. Panduan dibuat secara sistematis dengan langkah-langkah
              yang jelas sehingga dapat diikuti oleh pengguna dengan
              berbagai tingkat pengalaman.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah tersedia tips digital terbaru?</summary>

          <div class="faq-answer">
            <p>
              AI Mr Ferdy secara berkala menyediakan informasi dan tips
              mengenai AI, teknologi, aplikasi, produktivitas,
              keamanan digital, dan perkembangan teknologi terbaru.
            </p>
          </div>
        </details>

      </div>

      <!-- Dukungan -->
      <div class="faq-group" id="dukungan">

        <h2 class="faq-group-title">
          <span>ℹ️</span> Informasi Umum
        </h2>

        <details class="faq-details">
          <summary>Apa tujuan AI Mr Ferdy?</summary>

          <div class="faq-answer">
            <p>
              AI Mr Ferdy hadir sebagai platform AI Indonesia yang
              menyediakan AI Tools, teknologi digital, otomatisasi,
              aplikasi, informasi, tutorial, dan berbagai solusi
              produktivitas digital.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Apakah konten AI Mr Ferdy diperbarui secara berkala?</summary>

          <div class="faq-answer">
            <p>
              Ya. Konten dan informasi diperbarui secara berkala agar
              tetap relevan dengan perkembangan AI, teknologi digital,
              aplikasi, dan kebutuhan pengguna.
            </p>
          </div>
        </details>

        <details class="faq-details">
          <summary>Bagaimana cara mengikuti informasi terbaru?</summary>

          <div class="faq-answer">
            <p>
              Anda dapat mengunjungi AI Mr Ferdy secara berkala untuk
              menemukan AI Tools, aplikasi, artikel, tutorial,
              pembaruan, dan informasi teknologi terbaru.
            </p>
          </div>
        </details>

      </div>

      <!-- CTA -->
      <div class="faq-cta-strip">

        <h3>Masih punya pertanyaan?</h3>

        <p>
          Jelajahi AI Mr Ferdy untuk menemukan AI Tools, tutorial,
          aplikasi, informasi teknologi, dan berbagai solusi digital
          lainnya.
        </p>

        <div class="faq-cta-links">

          <a href="/aplikasi/">
            Aplikasi
          </a>

          <a href="/ai/">
            AI Tools
          </a>

          <a href="/pembaruan/">
            Pembaruan
          </a>

          <a href="/tentang-kami/">
            Tentang AI Mr Ferdy
          </a>

        </div>

      </div>

    </div>
  </section>

<script is:inline>
(function () {
  'use strict';

  var input = document.getElementById('faqSearchInput');
  var status = document.getElementById('faqSearchStatus');
  if (!input) return;

  var details = Array.prototype.slice.call(document.querySelectorAll('.faq-details'));
  var groups = Array.prototype.slice.call(document.querySelectorAll('.faq-group'));
  if (!details.length) return;

  function normalize(text) {
    return (text || '').toLowerCase().replace(/\s+/g, ' ').trim();
  }

  function rowText(el) {
    var summary = el.querySelector('summary');
    var answer = el.querySelector('.faq-answer');
    return normalize((summary ? summary.textContent : '') + ' ' + (answer ? answer.textContent : ''));
  }

  var cache = details.map(function (el) {
    return { el: el, text: rowText(el) };
  });

  function applyFilter() {
    var query = normalize(input.value);
    var visible = 0;

    cache.forEach(function (item) {
      var match = !query || item.text.indexOf(query) !== -1;
      item.el.hidden = !match;
      if (match) visible += 1;
    });

    groups.forEach(function (group) {
      var hasVisible = !!group.querySelector('.faq-details:not([hidden])');
      group.hidden = !hasVisible;
    });

    if (!status) return;

    if (!query) {
      status.hidden = true;
      status.textContent = '';
      return;
    }

    status.hidden = false;
    status.textContent = visible
      ? visible + ' pertanyaan ditemukan untuk "' + input.value.trim() + '"'
      : 'Tidak ada pertanyaan yang cocok. Coba kata kunci lain.';
  }

  input.addEventListener('input', applyFilter);
  input.addEventListener('search', applyFilter);
})();
</script>

</MainLayout>
