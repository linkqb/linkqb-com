---
import '../styles/tentang.css';
import MainLayout from '../layouts/MainLayout.astro';
import { SITE } from '../lib/site';

const pageTitle =
  'Tentang AI Mr Ferdy - Platform AI Indonesia';

const pageDescription =
  'Tentang AI Mr Ferdy, platform AI Indonesia yang menghadirkan AI Tools, teknologi digital, otomatisasi, SEO, aplikasi, dan solusi produktivitas digital.';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={SITE.url('tentang-kami')}
>

  <section class="page-hero">
    <div class="container">

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span>›</span>
        Tentang Kami
      </nav>

      <h1>Tentang AI Mr Ferdy - Platform AI Indonesia</h1>

      <p class="page-hero-lead">
        AI Mr Ferdy adalah platform AI Indonesia yang menghadirkan
        berbagai AI Tools, teknologi digital, otomatisasi, aplikasi,
        SEO, dan solusi produktivitas digital.
      </p>

    </div>
  </section>

  <section class="section">
    <div class="container">

      <div class="tentang-intro-grid">

        <div class="tentang-intro-card">
          <h2>Siapa Kami</h2>
          <p>
            AI Mr Ferdy adalah platform AI Indonesia yang menghadirkan
            berbagai AI Tools, teknologi digital, otomatisasi, aplikasi,
            SEO, dan solusi produktivitas digital. Platform ini
            dikembangkan untuk membantu pengguna memanfaatkan teknologi
            AI dalam berbagai kebutuhan digital.
          </p>
        </div>

        <div class="tentang-intro-card">
          <h2>Apa yang Kami Lakukan</h2>
          <p>
            AI Mr Ferdy menyediakan berbagai AI Tools, aplikasi,
            informasi teknologi, tutorial, serta solusi digital yang
            dapat membantu pengguna dalam pembuatan konten, otomatisasi,
            SEO, pengembangan website, dan pekerjaan digital lainnya.
          </p>
        </div>

        <div class="tentang-intro-card">
          <h2>Untuk Siapa Platform Ini</h2>
          <p>
            AI Mr Ferdy ditujukan untuk pengguna teknologi, kreator
            konten, pengembang, pelaku usaha, dan siapa saja yang ingin
            memanfaatkan kecerdasan buatan serta teknologi digital untuk
            meningkatkan produktivitas.
          </p>
        </div>

      </div>

      <div class="tentang-misi-grid">

        <div class="tentang-misi-box">
          <h2>Nilai dan Komitmen Kami</h2>
          <p>
            AI Mr Ferdy berkomitmen menghadirkan informasi, tools, dan
            solusi digital yang mudah dipahami serta dapat digunakan
            secara praktis. Kami terus mengikuti perkembangan artificial
            intelligence dan teknologi digital agar pengguna dapat
            memperoleh informasi dan solusi yang relevan.
          </p>
        </div>

        <div class="tentang-misi-box">
          <h2>Alasan Memilih AI Mr Ferdy</h2>
          <p>
            AI Mr Ferdy menggabungkan AI Tools, teknologi, otomatisasi,
            aplikasi, edukasi digital, SEO, dan berbagai informasi
            teknologi dalam satu ekosistem. Tujuannya adalah membantu
            pengguna menemukan teknologi yang sesuai dengan kebutuhan
            mereka.
          </p>
        </div>

      </div>

      <h2 class="tentang-nilai-title">Nilai yang Kami Pegang</h2>

      <div class="tentang-nilai-grid">

        <div class="tentang-nilai-card">
          <span>🤖</span>
          <h3>Artificial Intelligence</h3>
          <p>
            Mengembangkan dan menghadirkan berbagai teknologi serta
            tools berbasis kecerdasan buatan.
          </p>
        </div>

        <div class="tentang-nilai-card">
          <span>🔒</span>
          <h3>Keamanan</h3>
          <p>
            Mengutamakan penggunaan teknologi digital secara aman,
            bertanggung jawab, dan informatif.
          </p>
        </div>

        <div class="tentang-nilai-card">
          <span>💡</span>
          <h3>Inovasi</h3>
          <p>
            Mengikuti perkembangan teknologi dan menghadirkan solusi
            digital yang relevan dengan kebutuhan pengguna.
          </p>
        </div>

        <div class="tentang-nilai-card">
          <span>⚡</span>
          <h3>Produktivitas</h3>
          <p>
            Memanfaatkan AI dan teknologi digital untuk membantu
            menyederhanakan berbagai pekerjaan.
          </p>
        </div>

      </div>

      <div class="tentang-info">

        <h2>Informasi Platform</h2>

        <table>
          <tbody>

            <tr>
              <th>Nama Platform</th>
              <td>AI Mr Ferdy</td>
            </tr>

            <tr>
              <th>Jenis</th>
              <td>Platform AI dan Teknologi Digital</td>
            </tr>

            <tr>
              <th>Fokus</th>
              <td>
                Artificial Intelligence, AI Tools, otomatisasi,
                teknologi digital, SEO, aplikasi, dan produktivitas.
              </td>
            </tr>

            <tr>
              <th>Tujuan</th>
              <td>
                Mengembangkan dan menyediakan teknologi AI, AI Tools,
                aplikasi, serta solusi digital yang membantu pengguna
                meningkatkan produktivitas dan memanfaatkan teknologi
                secara lebih efektif.
              </td>
            </tr>

            <tr>
              <th>Wilayah</th>
              <td>Indonesia</td>
            </tr>

            <tr>
              <th>Bahasa</th>
              <td>Bahasa Indonesia</td>
            </tr>

          </tbody>
        </table>

      </div>

      <div class="tentang-cta">

        <h2>Pelajari Lebih Lanjut</h2>

        <p>
          Jelajahi berbagai AI Tools, aplikasi, informasi teknologi,
          tutorial, dan pembaruan yang tersedia di AI Mr Ferdy.
        </p>

        <div class="tentang-cta-links">

          <a href="/aplikasi/">Aplikasi</a>

          <a href="/ai/">AI Tools</a>

          <a href="/faq/">FAQ</a>

          <a href="/pembaruan/">Pembaruan</a>

        </div>

      </div>

    </div>
  </section>

</MainLayout>
